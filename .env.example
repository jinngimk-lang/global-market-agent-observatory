# Core runtime
DATABASE_PATH=data/observatory.db
TRADING_MODE=paper
EXECUTION_PROVIDER=paper
MARKET_SOURCE=replay
MARKET_SYMBOL=BTCUSDT
MARKET_INTERVAL=1m
REPLAY_DELAY_SECONDS=0.4
REPLAY_SEED=42
STARTING_CASH=100000

# Live execution requires ALL THREE settings below to be deliberate.
# Credentials alone never enable live trading.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
# Example deliberate Alpaca live configuration:
# TRADING_MODE=live
# EXECUTION_PROVIDER=alpaca
# ALPACA_BASE_URL=https://api.alpaca.markets
# LIVE_TRADING_ENABLED=true
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_LIVE_TRADING
#
# Example deliberate IBKR live configuration:
# TRADING_MODE=live
# EXECUTION_PROVIDER=ibkr
# IBKR_ENABLED=true
# IBKR_PAPER=false
# IBKR_ACCOUNT_ID=U1234567
# LIVE_TRADING_ENABLED=true
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_LIVE_TRADING

# Deterministic risk limits
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
MAX_ORDER_NOTIONAL=10000
MAX_SYMBOL_EXPOSURE=25000
MAX_GROSS_EXPOSURE=50000
DAILY_LOSS_LIMIT=2000
MAX_PORTFOLIO_DRAWDOWN=5000
MARKET_DATA_MAX_AGE_SECONDS=5
ACCOUNT_STATE_MAX_AGE_SECONDS=30

# Official research sources
SEC_USER_AGENT=GlobalMarketTradingPlatform contact@example.com
SEC_CIKS=
GITHUB_RELEASE_REPOSITORIES=ccxt/ccxt,freqtrade/freqtrade,hummingbot/hummingbot,QuantConnect/Lean,nautechsystems/nautilus_trader

# Account polling / reconciliation
ACCOUNT_POLL_SECONDS=15

# Alpaca execution / observation
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# IBKR Client Portal Gateway. The gateway must already be authenticated.
IBKR_ENABLED=false
IBKR_ACCOUNT_ID=
IBKR_BASE_URL=https://host.docker.internal:5000/v1/api
IBKR_VERIFY_SSL=false
# Explicitly declare whether the selected IBKR account/session is paper.
IBKR_PAPER=true
# Precautionary message IDs the autonomous system may confirm automatically.
# Empty means every IBKR precautionary reply requires operator intervention.
IBKR_AUTO_CONFIRM_MESSAGE_IDS=

# CCXT optional extra: pip install '.[crypto]'. Sandbox remains the default.
CCXT_EXCHANGE_ID=
CCXT_API_KEY=
CCXT_SECRET=
CCXT_PASSWORD=
CCXT_SANDBOX=true
