# Core runtime
DATABASE_PATH=data/observatory.db
TRADING_MODE=paper
EXECUTION_PROVIDER=paper
AUTO_TRADING_ENABLED=false

# Primary autonomous US-equity universe shown in the Trading Console.
TRADING_UNIVERSE=NVDA,SPCX,KLAC
SYMBOL_GROUPS=NVDA=semiconductor-ai,KLAC=semiconductor-ai,SPCX=growth-tech
RISK_FRACTION_PER_TRADE=0.01
MAX_GROUP_EXPOSURE=25000
REDUCE_FRACTION=0.5

# Safe local default: deterministic replay remains visibly separate from the
# US-equity trading universe. To receive real US-equity bars, switch
# MARKET_SOURCE=alpaca and provide Alpaca credentials below.
MARKET_SOURCE=replay
MARKET_SYMBOL=BTCUSDT
MARKET_INTERVAL=1m
MARKET_FEED_RETRY_SECONDS=1
MARKET_FEED_RETRY_MAX_SECONDS=30
REPLAY_DELAY_SECONDS=0.4
REPLAY_SEED=42
STARTING_CASH=100000

# Live execution requires ALL THREE settings below to be deliberate.
# Credentials alone never enable live trading.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
# Example deliberate Alpaca live configuration:
# TRADING_MODE=live
# EXECUTION_PROVIDER=alpaca
# ALPACA_BASE_URL=https://api.alpaca.markets
# LIVE_TRADING_ENABLED=true
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_LIVE_TRADING
#
# Example deliberate IBKR live configuration:
# TRADING_MODE=live
# EXECUTION_PROVIDER=ibkr
# IBKR_ENABLED=true
# IBKR_PAPER=false
# IBKR_ACCOUNT_ID=U1234567
# LIVE_TRADING_ENABLED=true
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_LIVE_TRADING

# Deterministic risk limits. Keep the trading universe explicitly allowlisted.
ALLOWED_SYMBOLS=NVDA,SPCX,KLAC,BTCUSDT,ETHUSDT
MAX_ORDER_NOTIONAL=10000
MAX_SYMBOL_EXPOSURE=25000
MAX_GROSS_EXPOSURE=50000
DAILY_LOSS_LIMIT=2000
MAX_PORTFOLIO_DRAWDOWN=5000
MARKET_DATA_MAX_AGE_SECONDS=5
ACCOUNT_STATE_MAX_AGE_SECONDS=30

# Continuous strategy evaluation. It may reduce/HALT risk but cannot
# automatically promote or reactivate a strategy.
STRATEGY_LEARNING_ENABLED=true
STRATEGY_IMPROVEMENT_INTERVAL_SECONDS=30
STRATEGY_EVALUATION_HORIZON_SECONDS=300
STRATEGY_TRANSACTION_COST_BPS=10
# Entry/exit slippage assumptions are explicit modeled friction, not claims
# about observed market execution. Defaults stay zero until calibrated from
# evidence. A matching real broker fill overrides the modeled entry price.
STRATEGY_MODELED_ENTRY_SLIPPAGE_BPS=0
STRATEGY_MODELED_EXIT_SLIPPAGE_BPS=0
STRATEGY_DEGRADATION_MIN_OBSERVATIONS=30
STRATEGY_DEGRADATION_WINDOW_OBSERVATIONS=50
STRATEGY_DEGRADATION_MIN_EXPECTANCY_AFTER_COSTS=0
STRATEGY_DEGRADATION_MAX_DRAWDOWN=0.10

# Options market structure / Put Wall / Call Wall / transparent GEX proxy.
OPTIONS_STRUCTURE_ENABLED=true
OPTIONS_STRUCTURE_REFRESH_SECONDS=60
OPTIONS_STRUCTURE_MAX_AGE_SECONDS=120
OPTIONS_EXPIRATION_HORIZON_DAYS=45
ALPACA_OPTIONS_FEED=indicative

# Official research sources
SEC_USER_AGENT=GlobalMarketTradingPlatform contact@example.com
SEC_CIKS=
GITHUB_RELEASE_REPOSITORIES=ccxt/ccxt,freqtrade/freqtrade,hummingbot/hummingbot,QuantConnect/Lean,nautechsystems/nautilus_trader

# Account polling / reconciliation
ACCOUNT_POLL_SECONDS=15

# Alpaca US-equity market data / execution / observation.
# For real US-equity monitoring while keeping autonomous orders off:
#   MARKET_SOURCE=alpaca
#   TRADING_MODE=paper
#   EXECUTION_PROVIDER=paper
#   AUTO_TRADING_ENABLED=false
# then provide the two credentials below locally. Do not commit them.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_MARKET_DATA_FEED=iex

# IBKR Client Portal Gateway. The gateway must already be authenticated.
IBKR_ENABLED=false
IBKR_ACCOUNT_ID=
IBKR_BASE_URL=https://host.docker.internal:5000/v1/api
IBKR_VERIFY_SSL=false
# Explicitly declare whether the selected IBKR account/session is paper.
IBKR_PAPER=true
# Precautionary message IDs the autonomous system may confirm automatically.
# Empty means every IBKR precautionary reply requires operator intervention.
IBKR_AUTO_CONFIRM_MESSAGE_IDS=

# CCXT optional extra: pip install '.[crypto]'. Sandbox remains the default.
CCXT_EXCHANGE_ID=
CCXT_API_KEY=
CCXT_SECRET=
CCXT_PASSWORD=
CCXT_SANDBOX=true
